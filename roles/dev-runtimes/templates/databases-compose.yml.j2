# Managed by liongate-env provisioning: edits are overwritten on the next run.
# Healthchecks let `up --wait` return only once the servers accept connections.
name: liongate-databases

services:
  postgres:
    image: {{ devruntimes_postgres_image }}
    container_name: liongate-postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: {{ devruntimes_postgres_user }}
      POSTGRES_PASSWORD: {{ devruntimes_postgres_password }}
    ports:
      - "127.0.0.1:{{ devruntimes_postgres_port }}:5432"
    volumes:
      - postgres-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD", "pg_isready", "-U", "{{ devruntimes_postgres_user }}"]
      interval: 5s
      retries: 12

  mysql:
    image: {{ devruntimes_mysql_image }}
    container_name: liongate-mysql
    restart: unless-stopped
    environment:
      MYSQL_ROOT_PASSWORD: {{ devruntimes_mysql_root_password }}
    ports:
      - "127.0.0.1:{{ devruntimes_mysql_port }}:3306"
    volumes:
      - mysql-data:/var/lib/mysql
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "127.0.0.1", "-uroot", "-p{{ devruntimes_mysql_root_password }}"]
      interval: 5s
      retries: 12

volumes:
  postgres-data:
  mysql-data:
